APP_NAME=Upokoron
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Timestamps are stored in UTC. APP_DISPLAY_TIMEZONE is what the business
# thinks in: report day boundaries, document numbering, and displayed times.
APP_TIMEZONE=UTC
APP_DISPLAY_TIMEZONE=Asia/Dhaka

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=upokoron
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax

# Sanctum SPA mode. Requests from these origins get an HttpOnly session
# cookie instead of a bearer token, so no credential is reachable from JS.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Product images are written straight into a served directory rather than
# storage/, because cPanel usually disables symlink() and `storage:link`
# then fails silently. In production point this at the document root, e.g.
# UPLOADS_ROOT=/home/USER/public_html/uploads
# UPLOADS_URL=https://example.com/uploads
UPLOADS_ROOT=
UPLOADS_URL=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@upokoron.test"
MAIL_FROM_NAME="${APP_NAME}"

CURRENCY_CODE=BDT
CURRENCY_SYMBOL=৳

# Seeded store owner. OwnerSeeder REFUSES to run in production without
# OWNER_PASSWORD set -- a default admin password nobody remembers to change
# is how stores get taken over. Never commit a real value here.
OWNER_EMAIL=owner@example.com
OWNER_PHONE=01700000000
OWNER_PASSWORD=

# Product import (Admin > Products > Import). The one place this server
# fetches an address a user typed, so the private-host guard is what stops it
# being pointed at localhost or a cloud metadata service. Turn it off only to
# import from a machine on your own network.
IMPORT_BLOCK_PRIVATE_HOSTS=true
IMPORT_TIMEOUT=10
IMPORT_MAX_BYTES=2097152
IMPORT_MAX_IMAGES=6
IMPORT_MAX_CSV_ROWS=2000
