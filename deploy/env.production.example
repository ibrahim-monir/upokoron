# Upokoron — production .env template
#
# Copy to ~/laravel/.env on the server and fill in the CAPITALISED
# placeholders. Then chmod 600 it: this file holds the database password and
# the key that decrypts every session cookie.
#
# Nothing here should ever be committed with real values in it.

APP_NAME=Upokoron
APP_ENV=production

# Generate on the server:  php artisan key:generate
# Do NOT reuse the development key, and do not change it after go-live --
# every existing session and encrypted value becomes unreadable.
APP_KEY=

# false. Always. With debug on, a stack trace on any error shows the database
# password and the app key to whoever triggered it.
APP_DEBUG=false

APP_URL=https://YOUR-DOMAIN.com

# Timestamps are stored in UTC; the business thinks in Dhaka time. Report day
# boundaries and document numbering follow APP_DISPLAY_TIMEZONE.
APP_TIMEZONE=UTC
APP_DISPLAY_TIMEZONE=Asia/Dhaka

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# error, not debug: shared hosting disk quotas are small and a debug log on a
# busy shop fills them, at which point writes start failing everywhere.
LOG_LEVEL=error

# cPanel prefixes both names with your account name, e.g. myshop_upokoron.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=CPANELUSER_upokoron
DB_USERNAME=CPANELUSER_upokoron
DB_PASSWORD=THE-PASSWORD-YOU-GENERATED

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/

# Leading dot so the cookie also works on www. Must match the real domain, or
# login silently fails: the browser accepts the response and drops the cookie.
SESSION_DOMAIN=.YOUR-DOMAIN.com

# The login cookie must never travel over plain HTTP. Turn this on only once
# the SSL certificate is actually issued -- with it on and no certificate,
# nobody can log in at all.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# The React app and the API are served from the same origin in production, so
# there is exactly one stateful domain. Include www if you serve it.
SANCTUM_STATEFUL_DOMAINS=YOUR-DOMAIN.com,www.YOUR-DOMAIN.com
FRONTEND_URL=https://YOUR-DOMAIN.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Database-backed, because shared hosting has no Redis and no long-running
# worker. The cron entry drains the queue once a minute.
QUEUE_CONNECTION=database
CACHE_STORE=database

# Product images are written straight into the served directory. `php artisan
# storage:link` is deliberately not used -- cPanel usually disables symlink()
# and the command then fails in a way that is easy to miss.
#
# ABSOLUTE filesystem path, no trailing slash:
UPLOADS_ROOT=/home/CPANELUSER/public_html/uploads
# Root-relative URL, so the origin is never baked into stored image paths:
UPLOADS_URL=/uploads

# cPanel's local mail server. If delivery to Gmail lands in spam, switch to an
# SMTP provider and set up SPF and DKIM for the domain.
MAIL_MAILER=smtp
MAIL_HOST=localhost
MAIL_PORT=25
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS="no-reply@YOUR-DOMAIN.com"
MAIL_FROM_NAME="${APP_NAME}"

CURRENCY_CODE=BDT
CURRENCY_SYMBOL=৳

# The first staff account, created by `php artisan db:seed --class=OwnerSeeder`.
# The seeder REFUSES to run in production unless OWNER_PASSWORD is set, so
# there is no default admin password to forget about. Use a long random one,
# change it after the first login, then blank this line out again.
OWNER_EMAIL=you@YOUR-DOMAIN.com
OWNER_PHONE=017XXXXXXXX
OWNER_PASSWORD=
