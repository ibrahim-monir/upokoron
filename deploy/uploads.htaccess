# Upokoron — public_html/uploads/.htaccess
#
# Uploads are validated on the way in: real MIME read from the file's own
# bytes, generated filenames, size caps. This is the second line of defence,
# and the one that matters if the first is ever bypassed.
#
# Nothing in this directory may EXECUTE. A file that reaches here and manages
# to look like a script must be served as plain text, never run.

<FilesMatch "\.(php|phtml|php3|php4|php5|php7|php8|phar|pl|py|cgi|asp|aspx|sh|shtml)$">
    Require all denied
</FilesMatch>

<IfModule mod_php.c>
    php_flag engine off
</IfModule>

RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
AddType text/plain .php .phtml .php3 .php4 .php5 .php7 .php8 .phar

# SVG is markup and can carry script, so it is never rendered inline from a
# path a visitor could be tricked into opening directly.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'unsafe-inline'"
</IfModule>

Options -Indexes -ExecCGI
